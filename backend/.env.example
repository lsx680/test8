# ---- 运行环境 ----
NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai

# ---- MySQL（仅应用主机可达；生产请使用最小权限账号）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oes_app
DB_PASSWORD=oes_app_pwd
DB_NAME=oes
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ---- JWT ----
# 生产环境必须替换为不少于 32 字节的随机串：openssl rand -hex 32
JWT_SECRET=please-change-this-secret-to-a-random-32-byte-string
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

# ---- 密码哈希 ----
BCRYPT_ROUNDS=10

# ---- 其它 ----
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
BACKUP_DIR=./backups

# ---- 仅供 scripts/init-db.js 使用（初始化库表的管理员账号）----
DB_ROOT_USER=root
DB_ROOT_PASSWORD=root_pwd